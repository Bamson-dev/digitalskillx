{
  "crons": [
    {
      "path": "/api/cron/inactivity",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/bulk-import",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/cron/email-outbox",
      "schedule": "45 9 * * *"
    },
    {
      "path": "/api/cron/email-campaigns",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/checkout-abandon",
      "schedule": "20 10 * * *"
    },
    {
      "path": "/api/cron/content-factory",
      "schedule": "5 10 * * *"
    }
  ],
  "functions": {
    "app/(admin)/admin/(panel)/email-campaigns/page.tsx": {
      "includeFiles": "content/aimoneycode-30-day-email-sequence.md",
      "maxDuration": 120
    },
    "app/api/cron/email-campaigns/route.ts": {
      "includeFiles": "content/aimoneycode-30-day-email-sequence.md",
      "maxDuration": 120
    },
    "app/api/admin/email-campaigns/drain/route.ts": {
      "includeFiles": "content/aimoneycode-30-day-email-sequence.md",
      "maxDuration": 120
    }
  }
}
