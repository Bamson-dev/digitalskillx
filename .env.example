# ──────────────────────────────────────────────────────────────
# DigitalSkillX — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# Production: https://digitalskillx.com
# ──────────────────────────────────────────────────────────────

# Public site URL (auth redirects, certificate verify links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────
# From: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Server-only secret. NEVER expose to the client / commit real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Email (ZeptoMail SMTP) ────────────────────────────────────
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.com
ZEPTOMAIL_SMTP_PORT=587
ZEPTOMAIL_SMTP_USER=emailapikey
ZEPTOMAIL_SMTP_PASSWORD=your-zeptomail-smtp-password
ZEPTOMAIL_FROM_EMAIL=courses@digitalskillx.com
ZEPTOMAIL_FROM_NAME="DigitalSkillX"

# ── YouTube Data API v3 ─────────────────────────────────────
# Coolify: Runtime only for secrets. NODE_ENV=production must be Runtime only (not build time) or Docker/Nixpacks skips devDependencies and build fails.
YOUTUBE_API_KEY=your-youtube-data-api-key

# ── AI assistant (DeepSeek preferred, Anthropic fallback) ─────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Content Factory artwork (optional; skipped when unset)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Free Learning Library + Content Factory (opt-in)
CONTENT_FACTORY_ENABLED=false

# ── Paystack (Naira payments) ─────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
# Set to true only if your Paystack account has USD settlement enabled
PAYSTACK_USD_ENABLED=false

# ── Platform admin bootstrap (staging) ──────────────────────
# On server startup, creates admin profile if missing. Never overwrites existing passwords
# unless ADMIN_PASSWORD_SYNC=true (use on Coolify/staging when you change ADMIN_PASSWORD).
ADMIN_EMAIL=admin@digitalskillx.com
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_PASSWORD_SYNC=false
# Staging only: set to false to skip Google Authenticator setup for admin login.
ADMIN_MFA_REQUIRED=false

# ── Sentry error tracking ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Scheduled jobs (Vercel Cron) ──────────────────────────────
# Bearer secret required by /api/cron/* endpoints.
CRON_SECRET=generate-a-long-random-string
# Days of inactivity before a student is flagged / emailed.
INACTIVITY_DAYS=7

# ── Sales Page importer (Phase 1) ─────────────────────────────
# Opt-out: SALES_PAGE_IMPORT_ENABLED=false
SALES_PAGE_IMPORT_ENABLED=true

# Storage provider for NEW Sales Page assets (does NOT migrate Supabase Storage).
# local (default) | filesystem | s3 | contabo-s3
STORAGE_PROVIDER=local
# STORAGE_LOCAL_ROOT=.data/storage

# Contabo Object Storage (S3-compatible) — preferred when available
# CONTABO_S3_ENDPOINT=https://eu2.contabostorage.com
# CONTABO_S3_REGION=default
# CONTABO_S3_BUCKET=your-bucket
# CONTABO_S3_ACCESS_KEY=
# CONTABO_S3_SECRET_KEY=
# CONTABO_S3_PUBLIC_BASE_URL=

# Contabo VPS filesystem alternative
# CONTABO_STORAGE_ROOT=/var/www/digitalskillx/storage
