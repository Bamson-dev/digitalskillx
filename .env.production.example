# Public values. Required at build time by Next.js and also used at runtime.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Runtime-only settings belong in Coolify's encrypted environment UI. Do not put
# credentials in this file, copy it into an image, or commit a populated file.
# See docs/CONTABO-DEPLOYMENT-RUNBOOK.md for the complete variable checklist.
